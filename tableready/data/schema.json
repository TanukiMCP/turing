{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Table Ready game entry",
  "type": "object",
  "required": ["slug", "name", "kind", "publisher", "players", "edition", "status", "source", "key_numbers", "setup", "turn", "end", "scoring", "missed"],
  "additionalProperties": false,
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string"},
    "kind": {"enum": ["board", "card", "dice"]},
    "publisher": {"type": "string"},
    "designer": {"type": "string"},
    "players": {
      "type": "object", "required": ["min", "max", "covered"], "additionalProperties": false,
      "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer"}, "covered": {"type": "array", "items": {"type": "integer"}, "minItems": 1}, "not_playable": {"type": "array", "items": {"type": "integer"}, "minItems": 1}}
    },
    "age": {"type": "string"},
    "play_time": {"type": "string"},
    "edition": {"type": "string"},
    "status": {"enum": ["complete", "partial"]},
    "source": {
      "type": "object", "required": ["title", "url", "host", "retrieved"], "additionalProperties": false,
      "properties": {"title": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}, "host": {"enum": ["publisher", "mirror"]}, "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}
    },
    "key_numbers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "value"], "additionalProperties": false, "properties": {"label": {"type": "string"}, "value": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/byCount"}]}}}},
    "setup": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/item"}, {"required": ["group"]}]}},
    "turn": {"type": "object", "required": ["summary", "steps"], "additionalProperties": false, "properties": {"summary": {"type": "string"}, "steps": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
    "round_end": {"type": "array", "items": {"type": "string"}},
    "end": {"type": "string"},
    "scoring": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "tiebreak": {"type": "string"},
    "missed": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "not_covered": {"type": "array", "items": {"type": "string"}},
    "unverified": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "byCount": {"type": "object", "minProperties": 1, "patternProperties": {"^[0-9]+$": {"type": "string"}}, "additionalProperties": false},
    "item": {
      "type": "object", "required": ["text"], "additionalProperties": false,
      "properties": {"text": {"type": "string"}, "group": {"enum": ["table", "each player", "to start"]}, "only": {"type": "array", "items": {"type": "integer"}, "minItems": 1}, "by_count": {"$ref": "#/$defs/byCount"}}
    }
  }
}
